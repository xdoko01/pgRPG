{
	"$id": "movable.schema.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",

	"title": "Movable Component",
	"description": "Schema validating the Movable component.",

	"examples" : [
		{"type" : "movable:Movable", "params" : {"velocity" : 10}},
		{"type" : "movable:Movable", "params" : {"velocity" : 5, "accelerate" : 2}},
		{"type" : "movable:Movable", "params" : {"velocity" : 50, "accelerate" : -2}}
	],

	"required": [ "type", "params"],
	"properties": {
		"type": {
			"description" : "Path to the component class.",
			"enum": [ "movable:Movable" ]
		},
		"params": {
			"title": "Component parameters",
			"description" : "Parameters of the Movable component class - 'velocity', 'accelerate'.",
			"type": "object",
			"required": ["velocity"],
			"allOf": [ { "$ref": "#/$defs/cond_params" } ],
			"properties": {
				"velocity" : {
					"title": "Velocity",
					"description": "Speed of the movement. May also be a template variable, since entity and template definitions are parameterised before instantiation.",
					"anyOf": [
						{
							"type": "integer",
							"exclusiveMinimum": 0
						},
						{ "$ref": "../definitions.schema.json#/definitions/template_var" }
					]
				},
				"accelerate" : {
					"title": "Acceleration Rate",
					"description": "Pace of acceleration. May also be a template variable, since entity and template definitions are parameterised before instantiation.",
					"default" : 0,
					"anyOf": [
						{ "type": "integer" },
						{ "$ref": "../definitions.schema.json#/definitions/template_var" }
					]
				}
			}
		}
	},

	"$defs" : {
		"cond_params": {
			"description" : "Conditions for 'param' properties.",
			"anyOf": [true]
		}
	}
	
}